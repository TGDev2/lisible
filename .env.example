# ===========================================
# SME Studio - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ===========================================
# Database (Neon PostgreSQL)
# ===========================================
# Get your connection string from https://console.neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.eu-central-1.aws.neon.tech/sme-studio?sslmode=require

# ===========================================
# Authentication (NextAuth.js v5 / Auth.js)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# Object Storage (Scaleway S3)
# ===========================================
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=sme-studio-dev
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# ===========================================
# Redis (Upstash) for BullMQ
# ===========================================
REDIS_URL=rediss://default:xxx@eu1-xxx.upstash.io:6379

# ===========================================
# Stripe (Payments)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ===========================================
# STT Providers
# ===========================================
OPENAI_API_KEY=sk-xxx
DEEPGRAM_API_KEY=xxx

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY=re_xxx
